{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kairo Setup",
  "version": "0.1.4",
  "identifier": "gg.kairo.setup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kairo Setup",
        "width": 780,
        "height": 500,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "backgroundColor": "#07070c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
