{
  "schemaVersion": 1,
  "id": "kairo",
  "version": "${version}",
  "name": "Kairo Client",
  "description": "Módulos do Kairo: HUD (FPS, CPS, keystrokes, coordenadas, ping, relógio), freelook, zoom e auto sprint.",
  "authors": [
    "Carlos"
  ],
  "license": "MIT",
  "icon": "assets/kairo/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "gg.kairo.KairoClient"
    ]
  },
  "mixins": [
    "kairo.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "${mc_range}",
    "java": ">=${java}",
    "fabric-api": "*"
  }
}
